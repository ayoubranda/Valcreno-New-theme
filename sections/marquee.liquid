<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {% for block in section.blocks %}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="dot"></span></span>
    {% endfor %}
    {% for block in section.blocks %}
      <span>{{ block.settings.text }}<span class="dot"></span></span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Authenticité garantie"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Authenticité garantie" } },
        { "type": "item", "settings": { "text": "Livraison assurée à l'international" } },
        { "type": "item", "settings": { "text": "Service après-vente à vie" } },
        { "type": "item", "settings": { "text": "Paiement sécurisé" } },
        { "type": "item", "settings": { "text": "Retours sous 30 jours" } }
      ]
    }
  ]
}
{% endschema %}
