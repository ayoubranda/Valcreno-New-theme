<footer class="site-footer">
  <div class="vc-container">

    <div class="footer-signature">
      <span class="footer-signature__eyebrow">{{ section.settings.eyebrow }}</span>
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="footer-signature__logo"
        />
      {% else %}
        <img src="{{ 'valcreno-wordmark.png' | asset_url }}" alt="{{ shop.name }}" class="footer-signature__logo" />
      {% endif %}
      <p class="footer-signature__quote">{{ section.settings.quote }}</p>
      <div class="footer-signature__trust">
        <span>{{ 'footer.trust_authenticity' | t }}</span>
        <span class="dot"></span>
        <span>{{ 'footer.trust_service' | t }}</span>
        <span class="dot"></span>
        <span>{{ 'footer.trust_shipping' | t }}</span>
      </div>
    </div>

    <div class="footer-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            <div class="footer-col" {{ block.shopify_attributes }}>
              <h5>{{ block.settings.heading }}</h5>
              {% if block.settings.menu != blank %}
                <ul>
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% when 'newsletter' %}
            <div class="footer-news" {{ block.shopify_attributes }}>
              <span class="footer-news__eyebrow">{{ block.settings.eyebrow }}</span>
              <h4 class="footer-news__title">{{ block.settings.heading }}</h4>
              <p class="footer-news__text">{{ block.settings.text }}</p>
              {% form 'customer', class: 'footer-news__form' %}
                <input type="hidden" name="contact[tags]" value="newsletter" />
                <input type="email" name="contact[email]" required placeholder="{{ 'footer.email_placeholder' | t }}" aria-label="{{ 'footer.email_placeholder' | t }}" />
                <button type="submit">
                  {{ 'footer.subscribe' | t }}
                  <svg width="28" height="10" viewBox="0 0 28 10" fill="none" stroke="currentColor" stroke-width="1"><path d="M0 5h24M20 1l4 4-4 4"/></svg>
                </button>
              {% endform %}
              <small class="footer-news__legal">{{ block.settings.legal }}</small>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="footer-social">
      <span class="footer-social__label">{{ section.settings.social_label }}</span>
      <div class="footer-social__icons">
        {% if shop.social_links.instagram != blank %}
          <a href="{{ shop.social_links.instagram }}" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"/></svg>
            <span>Instagram</span>
          </a>
        {% endif %}
        {% if shop.social_links.facebook != blank %}
          <a href="{{ shop.social_links.facebook }}" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M14 4h3v4h-3a1 1 0 00-1 1v3h4l-1 4h-3v8h-4v-8H6v-4h3V8a4 4 0 014-4z"/></svg>
            <span>Facebook</span>
          </a>
        {% endif %}
        {% if shop.social_links.tiktok != blank %}
          <a href="{{ shop.social_links.tiktok }}" aria-label="TikTok">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M13 4v11.5a3.5 3.5 0 11-3.5-3.5"/><path d="M13 4c.5 3 2.5 5 5.5 5.5"/></svg>
            <span>TikTok</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="footer-colophon">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <div class="footer-colophon__links">
        {% for link in linklists[section.settings.legal_menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Maison Valcreno"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Brand quote",
      "default": "Montres et sacs, façonnés à la main à Florence — pour le collectionneur de l'essentiel, depuis deux mille quatorze."
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "Suivez la maison"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Service client"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Lettres de la maison"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Éditions privées, annoncées discrètement."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Nouveautés et lettres d'atelier — jamais plus d'une fois par mois."
        },
        {
          "type": "text",
          "id": "legal",
          "label": "Privacy notice",
          "default": "Nous respectons votre vie privée et protégeons vos données personnelles conformément à la législation en vigueur."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Service client" } },
      { "type": "link_list", "settings": { "heading": "Maison" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
