{% schema %}
{
  "name": "WhatsApp Button",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "WhatsApp phone number",
      "info": "Include country code, e.g. +41000000000"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Contacter sur WhatsApp"
    }
  ]
}
{% endschema %}
