<section class="section featured" id="collections">
  <div class="vc-container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="title">{{ section.settings.title }}</h2>
      <span class="rule"></span>
    </div>

    <div class="collection-grid collection-grid--4">
      {% for block in section.blocks %}
        {% assign coll = collections[block.settings.collection] %}
        <a class="coll-card reveal" href="{{ coll.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="coll-card__media">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.heading | default: coll.title }}"
                loading="lazy"
                width="900"
                height="1125"
              />
            {% elsif coll.image %}
              <img
                src="{{ coll.image | image_url: width: 900 }}"
                alt="{{ coll.settings.heading | default: coll.title }}"
                loading="lazy"
                width="900"
                height="1125"
              />
            {% endif %}
          </div>
          <div class="coll-card__body">
            <h3 class="coll-card__title">{{ block.settings.heading | default: coll.title }}</h3>
            <p class="coll-card__desc">{{ block.settings.description }}</p>
            <span class="coll-card__explore">{{ 'collections.explore' | t }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Découvrez nos <em>collections</em></p>"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (if no collection)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Custom heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Calibres et finitions d'exception, pensés pour durer."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection", "settings": { "heading": "Montres", "description": "Calibres et finitions d'exception, pensés pour durer." } },
        { "type": "collection", "settings": { "heading": "Sacs à main", "description": "Cuirs italiens, ferrures laiton, lignes intemporelles." } },
        { "type": "collection", "settings": { "heading": "Nouveautés", "description": "Les dernières pièces entrées à l'archive." } },
        { "type": "collection", "settings": { "heading": "Éditions limitées", "description": "Tirages confidentiels, numérotés à la main." } }
      ]
    }
  ]
}
{% endschema %}
