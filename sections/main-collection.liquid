<div class="header-spacer"></div>

<section class="section">
  <div class="vc-container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ collection.title }}</span>
      <h1 class="title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p class="sub">{{ collection.description }}</p>
      {% endif %}
      <span class="rule"></span>
    </div>

    <div class="product-grid">
      {% paginate collection.products by 12 %}
        {% for product in collection.products %}
          <a class="prod-card reveal" href="{{ product.url }}">
            <div class="prod-card__media">
              {% if product.compare_at_price > product.price %}
                {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="prod-card__badge is-sale">−{{ discount }}%</span>
              {% elsif product.tags contains 'new' %}
                <span class="prod-card__badge is-new">{{ 'products.new' | t }}</span>
              {% endif %}
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  loading="lazy"
                  width="900"
                  height="1125"
                />
              {% endif %}
              {% if product.images[1] %}
                <img
                  src="{{ product.images[1] | image_url: width: 900 }}"
                  alt=""
                  loading="lazy"
                  width="900"
                  height="1125"
                />
              {% endif %}
            </div>
            <div class="prod-card__body">
              <p class="prod-card__cat">{{ product.type }}</p>
              <h3 class="prod-card__title">{{ product.title }}</h3>
              <div class="prod-card__price">
                {% if product.compare_at_price > product.price %}
                  <span class="sale">{{ product.price | money }}</span>
                  <span class="was">{{ product.compare_at_price | money }}</span>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}

        {% if paginate.pages > 1 %}
          <nav class="pagination" style="grid-column: 1 / -1; display: flex; justify-content: center; gap: 16px; margin-top: 64px;">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="vc-btn">{{ 'general.previous' | t }}</a>
            {% endif %}
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="vc-btn">{{ 'general.next' | t }}</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
