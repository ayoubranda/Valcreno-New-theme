<div class="header-spacer"></div>

<section class="section">
  <div class="vc-container">
    <div class="pdp" style="display: grid; grid-template-columns: 1fr; gap: 48px;">

      <div class="pdp__gallery" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
        {% for image in product.images %}
          <div style="{% if forloop.first %}grid-column: 1 / -1;{% endif %} aspect-ratio: 4/5; overflow: hidden; background: var(--vc-white); border: 1px solid var(--border-hair);">
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ image.alt | default: product.title }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </div>
        {% endfor %}
      </div>

      <div class="pdp__info">
        <p class="prod-card__cat">{{ product.type }}</p>
        <h1 style="font-family: var(--font-display); font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1.1; margin: 8px 0 16px;">{{ product.title }}</h1>

        <div class="prod-card__price" style="font-size: 18px; margin-bottom: 24px;">
          {% if product.compare_at_price > product.price %}
            <span class="sale">{{ product.price | money }}</span>
            <span class="was">{{ product.compare_at_price | money }}</span>
          {% else %}
            <span>{{ product.price | money }}</span>
          {% endif %}
        </div>

        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div style="margin-bottom: 20px;">
                <label class="vc-label" style="display: block; margin-bottom: 10px;">{{ option.name }}</label>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                  {% for value in option.values %}
                    <label style="display: inline-flex; align-items: center; justify-content: center; min-width: 44px; padding: 10px 16px; border: 1px solid var(--border-soft); font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: border-color 240ms, background 240ms;">
                      <input type="radio" name="option-{{ option.name | handleize }}" value="{{ value }}" style="position: absolute; opacity: 0; pointer-events: none;" {% if option.selected_value == value %}checked{% endif %} />
                      {{ value }}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <button type="submit" class="vc-btn is-block" style="margin-top: 16px;" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              {{ 'products.add_to_cart' | t }}
            {% else %}
              {{ 'products.sold_out' | t }}
            {% endif %}
          </button>
        {% endform %}

        {% if product.description != blank %}
          <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border-hair);">
            <div class="vc-body">{{ product.description }}</div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .pdp { grid-template-columns: 1.2fr 1fr !important; gap: 64px !important; }
    .pdp__info { position: sticky; top: 120px; align-self: start; }
  }
  .pdp__info input[type="radio"]:checked + * { border: none; }
  .pdp__info label:has(input:checked) {
    border-color: var(--vc-ink) !important;
    background: var(--vc-ink);
    color: var(--vc-cream);
  }
</style>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
