<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}" />{% endif %}
<link rel="canonical" href="{{ canonical_url }}" />
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
{{ 'tokens.css' | asset_url | stylesheet_tag }}
{{ 'site.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{% if template.name == 'index' %}
  {{ 'home.css' | asset_url | stylesheet_tag }}
{% endif %}
</head>
<body class="template-{{ template.name }}">

{% section 'header' %}

<main id="MainContent" role="main">
  {{ content_for_layout }}
</main>

{% section 'footer' %}

{% section 'whatsapp-fab' %}

{{ 'site.js' | asset_url | script_tag }}

</body>
</html>
